{
  "name": "scoutboy",
  "version": "0.1.0",
  "private": true,
  "description": "ScoutBoy \u2014 FUT.gg-style real-life football player discovery (MVP: U23 attackers & midfielders in Europe)",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "dev:web": "pnpm --filter @scoutboy/web dev",
    "build:web": "pnpm --filter @scoutboy/web build",
    "lint:web": "pnpm --filter @scoutboy/web lint",
    "test:web": "pnpm --filter @scoutboy/web test",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "visual": "bash scripts/run_visual.sh",
    "visual:update": "bash scripts/run_visual.sh --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.48.0"
  }
}
