# Copy to .env (backend). Development keeps safe, zero-setup defaults.

# Explicit runtime mode: development, test, or production.
# Production requires a non-empty admin token and explicit non-wildcard web origins.
SCOUTBOY_ENVIRONMENT=development

# Database. Default is a local SQLite file. For Postgres:
#   DATABASE_URL=postgresql+psycopg://scoutboy:scoutboy@localhost:5432/scoutboy
DATABASE_URL=sqlite:///./db/scoutboy.db

# Minimum minutes threshold for a player-season to be eligible for scoring.
SCOUTBOY_MIN_MINUTES=450

# Shared secret gating /api/admin/* endpoints. Empty is allowed only outside production.
SCOUTBOY_ADMIN_TOKEN=

# Comma-separated browser origins allowed by CORS (no `*` anywhere in production).
SCOUTBOY_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-visible API URL compiled into the Next.js production bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Mock commercial fixture only: required solely with --credential-required-mode.
# This is not a real provider credential and the adapter never makes network requests.
SCOUTBOY_MOCK_COMMERCIAL_TOKEN=dummy-local-fixture-token

# ---------------------------------------------------------------------------
# Optional accounts (Milestone 8.4A)
# ---------------------------------------------------------------------------
# ScoutBoy runs completely without any of this. Leave SCOUTBOY_AUTH_ENABLED unset
# or false and the product is the anonymous application it has always been:
# Discovery, dossiers, leaderboards, Compare and Methodology are public, and My
# Favorites lives in browser storage. Turning accounts on only adds durable,
# cross-device favourites for people who choose to sign in.
#
# NEVER commit real keys. The Clerk SECRET key is not used by ScoutBoy at all and
# must never be given a NEXT_PUBLIC_ name; only the publishable key is browser-safe.

# Backend: turn the private /api/me/* surface on. When true, every setting below
# marked "required" must be present or the API refuses to start.
SCOUTBOY_AUTH_ENABLED=false

# Required when enabled. Your Clerk instance's Frontend API origin, which is also
# the `iss` claim on every session token it mints.
SCOUTBOY_CLERK_ISSUER=

# Required when enabled. Comma-separated origins allowed to have requested the
# token (`azp`). This is Clerk's documented CSRF defence for manual verification.
SCOUTBOY_CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Optional. Defaults to <issuer>/.well-known/jwks.json, where Clerk publishes the
# public keys tokens are verified against. Must be https.
SCOUTBOY_CLERK_JWKS_URL=

# Optional. Only set this if your Clerk JWT template actually mints an `aud`
# claim; a default Clerk session token does not carry one.
SCOUTBOY_CLERK_JWT_AUDIENCE=

# Optional bounds on remote key retrieval and clock-skew tolerance.
SCOUTBOY_CLERK_JWKS_CACHE_SECONDS=300
SCOUTBOY_CLERK_JWKS_MAX_KEYS=8
SCOUTBOY_CLERK_LEEWAY_SECONDS=10

# Frontend: the browser-safe publishable key. Its presence is what enables the
# account UI, so leaving it empty keeps the anonymous build.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional explicit switch. Unset => accounts are on iff a publishable key is
# present. "0"/"false" forces them off. "1"/"true" forces them on and FAILS THE
# BUILD if the publishable key is missing, so a broken deploy cannot silently
# degrade to anonymous.
NEXT_PUBLIC_SCOUTBOY_AUTH_ENABLED=
